# ===========================
# TELEGRAM BOT CONFIG
# ===========================
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# ===========================
# OWNER / ADMIN
# ===========================
OWNER_ID=123456789
# Multiple owners: 123456789,987654321
OWNER_IDS=123456789

# ===========================
# SUPABASE CONFIG
# ===========================
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ===========================
# FORCE SUBSCRIBE CHANNELS
# ===========================
# Format: @username or channel_id, separate with comma
FORCE_SUB_CHANNELS=@yourchannel,@yourgroup
FORCE_SUB_MESSAGE=Anda harus bergabung di Channel/Grup kami terlebih dahulu untuk menggunakan bot ini.

# ===========================
# BOT SETTINGS
# ===========================
# webhook or polling
BOT_MODE=polling
WEBHOOK_URL=https://your-app.railway.app
PORT=3000

# ===========================
# ANTI SPAM / COOLDOWN
# ===========================
COOLDOWN_SECONDS=3
MAX_SPAM_COUNT=5

# ===========================
# DEPLOYMENT
# ===========================
NODE_ENV=production
